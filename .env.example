# Monitoring Site Environment Variables Template
# Copy this to .env.local for local development or configure in Vercel Project Settings

# Neon Serverless Postgres Database (neon-fulvous-ridge)
# Automatically populated by Vercel when connected in Vercel Storage
DATABASE_URL=postgresql://user:password@ep-something.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://user:password@ep-something.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Administrative Authentication Credentials (Optional)
ADMIN_USERNAME=your_username
ADMIN_PASSWORD=your_password
